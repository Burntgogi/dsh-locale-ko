{
  "name": "dsh-locale-ko",
  "description": "Unofficial Korean localization plugin for DeepSeek Harness 0.2.2-rc.1 (web and desktop)",
  "version": "0.7.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Burntgogi/dsh-locale-ko.git"
  },
  "files": [
    "lib/**/*.js",
    "locale/ko/*.json",
    "styles/*.css",
    "cordis.patch.yml",
    "LICENSE",
    "locale/en.json",
    "locale/ko.json",
    "desktop/*.json",
    "desktop/*.mjs",
    "tools/*.mjs",
    "official-metadata-ko.json",
    "catalog-readmes/*.md",
    "previews/*/*.md",
    "previews/*/*.svg",
    "README.md",
    "CHANGELOG.md",
    "assets/plugins-ko.png",
    "NOTICE.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "homepage": "https://github.com/Burntgogi/dsh-locale-ko#readme",
  "bugs": {
    "url": "https://github.com/Burntgogi/dsh-locale-ko/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "korean",
    "i18n",
    "localization"
  ]
}
